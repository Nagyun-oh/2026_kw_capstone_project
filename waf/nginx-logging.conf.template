# Custom log format (overrides the image's default) — JSON access log with full request body,
# so every request (not just 4xx/5xx) is captured with its payload for the security log pipeline.
# remote_addr는 real_ip 모듈이 복원한 클라이언트 IP다(프록시 없는 로컬에서는 TCP 상대 IP와 동일).
log_format main escape=json '{"request_id":"$request_id","request_start_epoch_s":"$dg_request_start_epoch_s","request_end_epoch_s":"$msec","request_duration_s":"$request_time","test_run":"$http_x_dualguard_test_run","test_phase":"$http_x_dualguard_test_phase","test_kind":"$http_x_dualguard_test_kind","test_seq":"$http_x_dualguard_test_seq","remote_addr":"$remote_addr","remote_user":"$remote_user","time":"$time_iso8601","method":"$request_method","path":"$request_uri","status":$status,"body_bytes_sent":$body_bytes_sent,"http_referer":"$http_referer","http_user_agent":"$http_user_agent","http_x_forwarded_for":"$http_x_forwarded_for","request_body":"$request_body","headers":"$all_headers"}';

# upstream 값·클라이언트 입력 대신 WAF가 생성한 값으로 덮어쓴다.
more_set_headers 'X-Request-ID: $request_id';
more_set_headers 'X-DualGuard-Request-Start: $dg_request_start_epoch_s';

access_log ${ACCESSLOG} main;
access_log ${METRICSLOG} combined;

error_log ${ERRORLOG} ${LOGLEVEL};
