# MySQL 관리자 비밀번호
MYSQL_ROOT_PASSWORD='replace_with_random_root_password'

# 백엔드용 DB 계정, 로컬에서 사용하는 root는 사용 x
DB_USERNAME=security_app
DB_PASSWORD='replace_with_random_app_password'

# 랜덤 32바이트를 Base64로 인코딩한 AWS용 키
JWT_SECRET='replace_with_base64_encoded_random_key'
JWT_EXPIRATION_MS=86400000

# EC2 생성 후 실제 주소로 변경
CORS_ALLOWED_ORIGINS=http://REPLACE_WITH_EC2_PUBLIC_IP:3000