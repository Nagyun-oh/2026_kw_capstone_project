# MySQL 관리자 비밀번호
MYSQL_ROOT_PASSWORD='replace_with_random_root_password'

# 백엔드용 DB 계정, 로컬에서 사용하는 root는 사용 x
DB_USERNAME=security_app
DB_PASSWORD='replace_with_random_app_password'

# EC2 생성 후 실제 주소로 변경
CORS_ALLOWED_ORIGINS=https://security-monitor-kw.duckdns.org

# 운영 최초 관리자 발급
# 최초 생성할 때만 활성화하고, 완료 후 비활성화합니다.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# WAF가 X-Forwarded-For를 신뢰할 프록시 주소(호스트 Nginx가 Docker 게이트웨이를 거쳐 들어오는 IP)
# 확인: docker network inspect security-platform-aws_default -f '{{(index .IPAM.Config 0).Gateway}}'
WAF_TRUSTED_PROXY=172.18.0.1

# WAF 차단 목록 동기화용 비밀 토큰. backend와 waf가 같은 값을 사용한다(32자 이상).
# 생성 예: openssl rand -hex 32
WAF_SYNC_TOKEN=
# 선택: 조회 간격(초, 기본 10)과 절대 차단하지 않을 추가 IP(쉼표 구분).
# WAF_TRUSTED_PROXY와 Docker 게이트웨이는 자동으로 제외된다.
# WAF_SYNC_INTERVAL=10
# WAF_SYNC_EXCLUDE_IPS=
WAF_ID=aws-waf-1
WAF_SYNC_STALE_AFTER_SECONDS=60