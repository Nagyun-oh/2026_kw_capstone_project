# 최초 설정 시 .env로 복사하고 실제 값을 입력합니다.
# 실제 .env는 Git에 커밋하지 않습니다. 기존 .env를 덮어쓰지 마세요.

# 현재 로컬 구성은 기존 MySQL의 root 계정을 사용합니다.
# 기존 DB를 연결할 때는 실제 기존 비밀번호를 입력합니다.
DB_USERNAME=root
DB_PASSWORD='replace_with_existing_db_password'
MYSQL_DATA_DIR=./backend/mysql_data

# 랜덤 32바이트를 Base64로 인코딩한 키. 아래 문구는 유효한 키가 아닙니다.
JWT_SECRET='replace_with_base64_encoded_random_key'
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000

# 기존 로컬 Docker 볼륨의 실제 이름을 입력합니다.
# 이 예시 이름으로 볼륨이 자동 생성되지는 않습니다.
KAFKA_DATA_VOLUME=replace_with_existing_kafka_data_volume
ZOOKEEPER_DATA_VOLUME=replace_with_existing_zookeeper_data_volume
ZOOKEEPER_LOG_VOLUME=replace_with_existing_zookeeper_log_volume

# 현재 루트 Compose는 Fluent Bit 상태 볼륨을 사용하지 않습니다.
